# Hercules Docker — Environment Variables
# Copy this file to .env and adjust values for your deployment.

# MySQL / MariaDB
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_USER=hercules
MYSQL_PASSWORD=hercules
MYSQL_DATABASE=hercules

# Inter-server authentication
# IMPORTANT: These must match the 's1'/'p1' entry in the 'login' database table.
# To change from the default, update the login table after first startup:
#   UPDATE login SET userid='newuser', user_pass='newpass' WHERE account_id=1;
# Then set INTER_USERID and INTER_PASSWORD to match.
INTER_USERID=s1
INTER_PASSWORD=p1

# Public-facing IPs
# Set these to your server's public IP address so game clients can connect.
# Use 127.0.0.1 for local-only or LAN testing.
CHAR_IP=127.0.0.1
MAP_IP=127.0.0.1
API_IP=127.0.0.1

# Server ports
LOGIN_PORT=6900
CHAR_PORT=6121
MAP_PORT=5121
API_PORT=7121
